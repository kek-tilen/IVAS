# Configuration example only. Spring does NOT automatically load this .env file.
# Set process environment variables as shown in docs/Naloga4_LLM.md.
IVAS_AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
IVAS_AI_TIMEOUT_SECONDS=60
IVAS_AI_MAX_COMPLETION_TOKENS=4096

# Naloga 5: local gRPC and optional ARES browser (not loaded automatically).
IVAS_GRPC_PORT=50051
# Empty: Playwright Chromium. Set msedge or chrome for an installed browser.
IVAS_ARES_BROWSER_CHANNEL=
